# Core
PROJECT_NAME=CreatorHUB
ENV=prod

# Database
# Required in production. No defaults are provided.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Authentication and sessions
# JWT_SECRET must be at least 32 random characters.
JWT_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=10080

# Cookies and session scope
# Production profile: use a real HTTPS domain, AUTH_COOKIE_SECURE=true, and an explicit
# cookie domain such as .example.com. LAN/dev HTTP profile: set ENV=dev or ENV=test,
# AUTH_COOKIE_SECURE=false, and leave AUTH_COOKIE_DOMAIN empty for host-only cookies.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=creatorhub_csrf
SECURITY_SENSITIVE_ACTION_CONFIRMATION_REQUIRED=false
SECURITY_SENSITIVE_ACTION_REQUIRE_STEP_UP_MFA=true
SECURITY_STEP_UP_MFA_MAX_AGE_SECONDS=300
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=30

# Storage
UPLOADS_DIR=/data/uploads
CACHE_DIR=/data/cache
EXPORTS_DIR=/data/exports

# Redis and background workers
REDIS_URL=
TRUSTED_HOSTS=
PURGE_DELETED_USERS_INTERVAL_HOURS=6

# Local AI and image search
OLLAMA_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=moondream
IMAGE_HUNT_DEFAULT_SOURCES=wikimedia,openverse
OPENVERSE_API_BASE=https://api.openverse.engineering/v1

# Frontend
VITE_API_BASE=/api/v1
FRONTEND_PORT=3000

# CORS
# Use explicit origins only. Wildcards are not supported in production.
# LAN/dev example: http://192.168.178.250:3000
# Production example: https://creatorhub.example.com
CORS_ORIGINS=

# Outbound request security
OUTBOUND_ALLOWLIST_HOSTS=api.openverse.engineering,commons.wikimedia.org
OUTBOUND_BLOCK_PRIVATE_RANGES=true
OUTBOUND_REQUIRE_HTTPS=true
OUTBOUND_ALLOWED_PORTS=443

# Logging
LOG_LEVEL=INFO
UVICORN_LOG_LEVEL=INFO
UVICORN_ACCESS_LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_TO_STDOUT=true
LOG_TO_FILE=false
LOG_DIR=/data/logs
LOG_FILE_NAME=application.log
LOG_RETENTION_DAYS=30
SECURITY_LOG_LEVEL=WARNING
SECURITY_LOG_TO_SEPARATE_FILE=true
SECURITY_LOG_FILE_NAME=security-events.log
SECURITY_LOG_RETENTION_DAYS=90
SECURITY_LOG_PROPAGATE_TO_ROOT=true

# Observability
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PATH=/health/metrics
OBSERVABILITY_MONITOR_ENABLED=true
OBSERVABILITY_MONITOR_INTERVAL_SECONDS=30
ALERT_DB_FAILURE_CONSECUTIVE=3
ALERT_REDIS_FAILURE_CONSECUTIVE=3
ALERT_WORKER_FAILURE_CONSECUTIVE=3
ALERT_QUEUE_LENGTH_WARN=100
ALERT_QUEUE_LENGTH_CRITICAL=500
ALERT_FAILED_JOBS_CRITICAL=20
OTEL_ENABLED=false
OTEL_SERVICE_NAME=creatorhub-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLE_RATIO=0.2

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=10

# Upload limits
UPLOAD_ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp,.gif
UPLOAD_ALLOWED_PDF_EXTENSIONS=.pdf
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_PDF_BYTES=15728640
UPLOAD_MAX_IMAGE_WIDTH=8000
UPLOAD_MAX_IMAGE_HEIGHT=8000
UPLOAD_MAX_IMAGE_PIXELS=30000000

# Startup and deployment safety
BOOTSTRAP_INSTALL_TOKEN=
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BODY_BYTES=10485760
