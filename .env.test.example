# Test environment template for local Docker smoke tests.
# Values are non-production examples and must not be reused as real secrets.

PROJECT_NAME=CreatorHUB
ENV=test

POSTGRES_USER=creator_test
POSTGRES_PASSWORD=test_postgres_password_1234567890
POSTGRES_DB=creator_suite_test
DATABASE_URL=postgresql+psycopg://creator_test:test_postgres_password_1234567890@db:5432/creator_suite_test

REDIS_URL=redis://redis:6379/0
# For LAN smoke tests add the exact browser origin, for example:
# CORS_ORIGINS=http://localhost:31080,http://192.168.178.250:31080
CORS_ORIGINS=http://localhost:31080
# For LAN smoke tests include the LAN host/IP that appears in the browser URL.
TRUSTED_HOSTS=localhost,127.0.0.1,backend,frontend

JWT_SECRET=test_jwt_secret_value_1234567890_minimum_32_chars
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=test_admin_password_1234567890
BOOTSTRAP_INSTALL_TOKEN=test_bootstrap_token_1234567890

# Leave empty for host-only cookies when testing over localhost or a LAN IP.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=creatorhub_csrf
FRONTEND_PORT=31080
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=31800

UPLOADS_DIR=/data/uploads
CACHE_DIR=/data/cache
EXPORTS_DIR=/data/exports

OUTBOUND_ALLOWLIST_HOSTS=api.openverse.engineering,commons.wikimedia.org
OUTBOUND_BLOCK_PRIVATE_RANGES=true
OUTBOUND_REQUIRE_HTTPS=true
OUTBOUND_ALLOWED_PORTS=443

RATE_LIMIT_ENABLED=false
AUTO_ARCHIVE_ENABLED=false
SECURITY_SENSITIVE_ACTION_CONFIRMATION_REQUIRED=false
SECURITY_SENSITIVE_ACTION_REQUIRE_STEP_UP_MFA=false
PURGE_DELETED_USERS_INTERVAL_HOURS=6
OBSERVABILITY_DETAIL_AUTH_REQUIRED=false
